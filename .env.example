# =============================================================================
# Acuity — Environment Variables Configuration
# =============================================================================
# Copy this file to .env and set your PostgreSQL credentials.
# Note: .env is ignored by Git and will never be committed.

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acuity_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional: Direct PostgreSQL Connection URL (overrides individual variables if set)
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/acuity_db

# Optional: Frontend API Base URL (defaults to Vite proxy /api/v1)
# VITE_API_URL=http://localhost:8000/api/v1
